# --- Ollama (LLM + embeddings) ---
# Default values match the docker-compose stack. Override for local dev.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATION_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_ALT_EMBEDDING_MODEL=all-minilm

# --- Postgres + pgvector ---
PG_HOST=pgvector
PG_PORT=5432
PG_DB=rti
PG_USER=rti
# Set this for prod; the demo compose uses a dev-only default.
PG_PASSWORD=rti-dev-password-change-me

# --- API ---
PORT=8000
LOG_LEVEL=INFO

# --- Ingest ---
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
# A free NVD API key raises rate limits 50/30s -> 100/30s. Optional.
NVD_API_KEY=
# How many recent CVEs to seed the corpus with (0 = skip).
NVD_INITIAL_CVE_COUNT=200
