__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.env
.env.*
!.env.example

# never commit real keys
*.api.key
secrets.yaml

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# corpus is fetched at runtime — checked-in PDFs are intentional
corpus/cve_cache/
corpus/scratch/

# paper droppings
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
